function(patch_applied path result)
    execute_process(COMMAND "${GIT}" apply --no-index --reverse --check "${path}"
        RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
    if(status EQUAL 0)
        set("${result}" TRUE PARENT_SCOPE)
    else()
        set("${result}" FALSE PARENT_SCOPE)
    endif()
endfunction()

foreach(path IN ITEMS "${RECORDING_PATCH}" "${MODE_PATCH}" "${LIVE_PATCH}" "${CONTROLLER_PATCH}" "${PATCH}")
    patch_applied("${path}" applied)
    if(applied)
        break()
    endif()
    list(PREPEND pending "${path}")
endforeach()
foreach(path IN LISTS pending)
    execute_process(COMMAND "${GIT}" apply --no-index "${path}" COMMAND_ERROR_IS_FATAL ANY)
endforeach()
