+    const float requested = std::isfinite(frequency) && frequency > 0 ? frequency : 100.0f;
+    const auto rate = static_cast<uint16_t>(std::lround(std::clamp(requested, 1.0f, 1000.0f)));
+    sendCommand(1, CMD_VIBRATION_V2, {
