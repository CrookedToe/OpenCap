+void CommunityV1Calibration::resetChannel(std::size_t index, double low, double high) {
+    auto &c = channels.at(index);
+    c = Channel{};
+    c.workingLow = c.targetLow = std::isfinite(low) ? low : 0.0;
+    c.workingHigh = c.targetHigh = std::isfinite(high) ? high : c.workingLow;
+    c.usable = std::isfinite(low) && std::isfinite(high) && high - low >= minimumSpan;
 }
 
