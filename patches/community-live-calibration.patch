+static std::optional<opencap::SensorRange> readLiveRange(const nlohmann::json &entry, const std::string &serial) {
+    if (serial.empty() || !entry.is_object() || !entry.contains("serial") || entry["serial"] != serial ||
+        !entry.contains("ends")) return std::nullopt;
+    const auto &ends = entry.at("ends");
+    opencap::SensorRange range{};
+    if (!ends.is_array() || ends.size() != range.size()) return std::nullopt;
+    for (std::size_t e = 0; e < range.size(); ++e) {
+        if (!ends[e].is_array() || ends[e].size() != range[e].size()) return std::nullopt;
+        for (std::size_t i = 0; i < range[e].size(); ++i) {
+            const auto &value = ends[e][i];
+            if (!value.is_number_integer() || value.get<double>() < INT16_MIN || value.get<double>() > INT16_MAX)
+                return std::nullopt;
+            range[e][i] = value.get<int16_t>();
+        }
+    }
+    return range;
+}
