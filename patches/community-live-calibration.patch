+std::optional<opencap::SensorRange> UdCapV1Core::liveHandRange() const {
+    std::lock_guard guard(stateMutex);
+    if (!liveEnabled || udState != UD_INIT_STATE_LINKED || caliStat == UDCAP_V1_HAND_CALI_STAT_AUTO)
+        return std::nullopt;
+    return liveHand.range();
