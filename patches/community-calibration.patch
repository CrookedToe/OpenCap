+// Bend uses the fist capture. The three splay channels use the spread capture.
+static bool hasHandCalibrationMovement(const UdCapV1Core::CalibrationSamples &samples) {
+    for (std::size_t i = 0; i < 12; ++i) {
+        const bool splay = i == 4 || i == 7 || i == 10;
+        if (std::abs(samples[splay ? 2 : 0][i] - samples[1][i]) > 25) return true;
+    }
+    return false;
+}
+
+static std::optional<UdCapV1Core::CalibrationSamples> readHandCalibration(
+        const nlohmann::json &profile, const std::string &serial) {
+    if (serial.empty() || !profile.is_object() || !profile.contains("serial") ||
+        profile["serial"] != serial || !profile.contains("poses")) return std::nullopt;
+    const auto &poses = profile["poses"];
+    UdCapV1Core::CalibrationSamples samples{};
+    if (!poses.is_array() || poses.size() != samples.size()) return std::nullopt;
+    for (std::size_t pose = 0; pose < samples.size(); ++pose) {
+        if (!poses[pose].is_array() || poses[pose].size() != samples[pose].size()) return std::nullopt;
+        for (std::size_t i = 0; i < samples[pose].size(); ++i) {
+            const auto &value = poses[pose][i];
+            if (!value.is_number_integer()) return std::nullopt;
+            if (value.is_number_unsigned() && value.get<uint64_t>() > INT16_MAX) return std::nullopt;
+            const auto counts = value.get<int64_t>();
+            if (counts < INT16_MIN || counts > INT16_MAX) return std::nullopt;
+            samples[pose][i] = static_cast<int16_t>(counts);
+        }
+    }
+    if (!hasHandCalibrationMovement(samples)) return std::nullopt;
+    return samples;
+}
